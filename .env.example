# Copy to .env.local for local preview.
# On Netlify, add these in Project configuration > Environment variables,
# available to both builds and functions.
VOLTB_STORAGE=local
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SITE_ORIGIN=http://localhost:3000
# On Netlify set VOLTB_STORAGE=netlify; SITE_ORIGIN=https://your-site.netlify.app
# Only if the platform cannot supply automatic Blobs context:
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=
# All payment, email, SMS and courier providers are disabled in this trial.
